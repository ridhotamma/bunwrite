# Caddy without TLS: an upstream proxy or tunnel terminates HTTPS.
#
# Use this when Cloudflare (proxied or Tunnel), an ALB, nginx, or another
# provider already owns the public certificate and forwards plain HTTP here.
# Caddy keeps listening on port 80 and forwards every host to Bunwrite; it
# obtains no certificates and redirects nothing.
#
#   TLS_MODE=off
#
# Set PUBLIC_ENDPOINT to the public https:// address so OAuth callbacks and
# file links are correct even though this hop is HTTP.
#
# If the provider connects to this container directly, or you do not need
# Caddy's forwarding at all, leave COMPOSE_PROFILES empty and point the
# provider at 127.0.0.1:8080 instead.
{
	auto_https off
}

:80 {
	encode zstd gzip
	reverse_proxy {$UPSTREAM:bunwrite:8080} {
		# The public request arrived over the provider's HTTPS; this hop is HTTP.
		header_up X-Forwarded-Proto https

		lb_policy least_conn
		health_uri /v1/health
		health_interval 3s
		health_timeout 2s
		health_fails 3
		health_passes 1
		fail_duration 10s
		max_fails 5
		unhealthy_latency 5s
		lb_try_duration 3s
		transport http {
			# Bun closes idle connections after HTTP_IDLE_TIMEOUT (30s default);
			# keep Caddy's pool shorter so it never reuses a closed one.
			keepalive 5s
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}
