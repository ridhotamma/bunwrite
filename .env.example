# ---- Identity: keep these equal to the old Appwrite so no app config changes ----
# The Appwrite project ID every app sends in X-Appwrite-Project.
PROJECT_ID=6aca6eb80032e8a805a9
# Comma-separated accepted X-Appwrite-Key values. Put the existing APPWRITE_API_KEY here.
API_KEYS=
# Public URL of this API including /v1 (same hostname as before keeps the Google redirect URI valid).
PUBLIC_ENDPOINT=https://appwrite.pesanle.com/v1
# Signs JWTs and OAuth state. At least 32 random characters: `openssl rand -hex 32`
SECRET=
PROJECT_NAME=Pesanle

# Browser origins allowed to call the API and to be redirect targets (recovery links, OAuth).
ALLOWED_ORIGINS=*.pesanle.com,*.pesanle.id,localhost

# ---- Storage ----
PORT=8080
DATABASE_PATH=./data/pesanle.sqlite
STORAGE_PATH=./data/storage
# pesanle's appwrite.config.json: tables, buckets and functions (function code is read from beside it).
# Used by schema:push and the console's Schema page. Set SCHEMA_SYNC_ON_START=true to also apply it on every start
# (off by default so a restart never undoes a change made in the console).
SCHEMA_PATH=../pesanle/packages/appwrite-config/appwrite.config.json
SCHEMA_SYNC_ON_START=false

# ---- Console (/console) ----
CONSOLE_ENABLED=true
# Optional: create this admin on start if missing. Or run `bun run console:admin you@example.com`.
CONSOLE_ADMIN_EMAIL=
CONSOLE_ADMIN_PASSWORD=

# ---- Sessions (Appwrite project settings) ----
SESSION_DURATION=31536000
SESSIONS_LIMIT=10

# ---- Email (OTP codes, password recovery, team invites). Can also be set in the console ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 'tls' for implicit TLS on 465; empty uses STARTTLS when offered.
SMTP_SECURE=
SMTP_SENDER_EMAIL=no-reply@pesanle.com
SMTP_SENDER_NAME=Pesanle Team

# ---- Google sign-in. Can also be set in the console ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Functions ----
# dotenv file with the variables the functions need (APPWRITE_DATABASE_ID, STORAGE_S3_*, RENDER_FUNCTION_KEY, WhatsApp...).
FUNCTIONS_ENV_FILE=./functions.env
# Schedules to ignore. render's every-minute keep-warm ping only burns CPU here.
FUNCTIONS_SKIP_SCHEDULES=render
# python3 with WeasyPrint for the render function (apt install weasyprint python3-pip; pip install pypdfium2 Pillow).
PYTHON_BIN=python3
