# Bunwrite server configuration.
#
# Project identity and application settings live in the database and are
# managed in the console. The optional "First start only" values at the end of
# this file seed an empty database once; after that they are ignored.

# ---- Server ----
# Bind address. Use 127.0.0.1 behind a reverse proxy on the same host.
HOST=0.0.0.0
PORT=8080
# ---- Reverse proxy / HTTPS ----
# Start the bundled Caddy container? Docker Compose profiles control this and
# `docker compose up -d` reads it from this file automatically:
#   COMPOSE_PROFILES=caddy  -> Bunwrite + Caddy, automatic HTTPS for DOMAIN
#   COMPOSE_PROFILES=       -> Caddy is skipped; use your own proxy or tunnel
COMPOSE_PROFILES=caddy
# Public hostname. The bundled Caddy service obtains and renews a Let's Encrypt
# certificate for it automatically once the DNS record points at this server and
# ports 80/443 are open. No scheme or trailing slash here.
# DOMAIN=appwrite.example.com
# Caddy waits until DOMAIN points at this server before it starts, so a fresh
# `docker compose up` can run before DNS has propagated and still get its
# certificate on the first attempt. Set to false when a proxy or tunnel
# (Cloudflare) hides the origin address, or set CADDY_WAIT_IP to the address the
# record should point at.
CADDY_WAIT_DNS=true
# CADDY_WAIT_IP=203.0.113.10
# Public URL of this API including /v1, used for OAuth callbacks and file links.
# Defaults to https://$DOMAIN/v1 when DOMAIN is set, else http://localhost:$PORT/v1.
# PUBLIC_ENDPOINT=https://appwrite.example.com/v1
DATABASE_PATH=./data/bunwrite.sqlite
STORAGE_PATH=./data/storage
# Local folder for database backups when backup S3 storage is off.
BACKUPS_PATH=./data/backups

# ---- Docker image build (docker compose only) ----
# Build args, read by docker-compose.yml from this file. They only take effect
# when the image is rebuilt, so change them and run `docker compose up -d --build`.
# Leave both false for the small image; the app ignores these at runtime.
# python3 for python-* functions (~50 MB).
# BUNWRITE_WITH_PYTHON=true
# Chromium and fonts for HTML to PDF and images (~730 MB more on disk). Also turn
# rendering on in Console > Settings > HTML rendering.
# BUNWRITE_WITH_CHROMIUM=true

# ---- Schema ----
# Optional appwrite.config.json: tables, buckets and functions (function code is read from beside it).
# Used by schema:push and the console's Schema page. Set SCHEMA_SYNC_ON_START=true to also apply it on every start.
SCHEMA_PATH=
SCHEMA_SYNC_ON_START=false

# ---- Console (/console) ----
CONSOLE_ENABLED=true
# Optional: create this admin on start if missing. Or run `bun run console:admin you@example.com`.
CONSOLE_ADMIN_EMAIL=
CONSOLE_ADMIN_PASSWORD=

# ---- Request logs (stdout) ----
# One line per HTTP request: method, path, status, duration, request id, IP and project.
LOG_REQUESTS=true
# 'text' for journald, 'json' for a log collector.
LOG_FORMAT=text
# How many days the console keeps request logs. 0 keeps them until cleared.
# Both values can also be changed in Console Settings.
LOG_RETENTION_DAYS=7
# Store client IP addresses in request logs. Can also be changed in the console.
LOG_IP=true
# Proxies whose X-Forwarded-For carries the client's IP, for login limits,
# sessions and logs. Headers from anyone else are ignored, so clients cannot
# pick a new address to dodge the limits. Comma-separated:
#   private     loopback and private networks (default): Caddy, nginx, Cloudflare Tunnel
#   cloudflare  Cloudflare's edge addresses, and believe CF-Connecting-IP
#   none        always use the connection's address
#   10.1.0.0/16 or 203.0.113.5   a specific proxy
# Add cloudflare only when Cloudflare is the sole way in (origin firewalled or a tunnel).
# TRUSTED_PROXIES=private

# ---- Functions ----
# dotenv file with variables available to function executions.
FUNCTIONS_ENV_FILE=./functions.env
# Folder that relative function paths resolve against. It defaults to the folder containing SCHEMA_PATH.
# Only set it when the function code is not next to SCHEMA_PATH; you can also set it in Console > Settings > Functions.
FUNCTIONS_DIR=
# Run a function's build command (`commands`) on each new deployment from `appwrite push functions`.
# Commands run with sh on this host, not in Appwrite's Alpine image, so `apk` steps fail; set false to skip them.
FUNCTIONS_BUILD_COMMANDS=true
# Python runtime used by python-* functions.
PYTHON_BIN=python3

# ---- Resource tuning ----
# Bunwrite detects the cgroup (Docker, systemd, Kubernetes) or host CPU and RAM
# at startup and sizes the image/render/SQLite/upload limits below. Explicit
# values always win. Set AUTOTUNE=false to use the built-in defaults instead.
# AUTOTUNE=true
# Override detection on hosts where cgroups are not visible:
# AUTOTUNE_CPUS=2
# AUTOTUNE_MEMORY_MB=1024
# SQLite page cache in MB. Auto-tuned from RAM (8-64).
# SQLITE_CACHE_MB=
# Largest HTTP request body in MB. Auto-tuned from RAM (16-256).
# MAX_REQUEST_BODY_MB=
# Startup-only. The Docker entrypoint and systemd wrapper set these; set them
# here only to override. BUN_JSC_forceRAMSize is in bytes.
# BUN_JSC_forceRAMSize=
# MALLOC_ARENA_MAX=

# ---- Response caching and compression ----
# Browser cache lifetime for file views/downloads and image previews, in seconds.
# 0 makes the browser check every time. Can also be changed in Console > Settings > Caching.
CACHE_FILES_MAX_AGE=3888000
CACHE_PREVIEWS_MAX_AGE=2592000
# Days generated previews stay on disk; 0 keeps them until the file changes.
PREVIEW_CACHE_DAYS=30
# Compress responses (Brotli, else gzip) and realtime messages. Set false only
# when a reverse proxy in front already compresses.
COMPRESSION=true

# ---- Image previews ----
# libvips threads. Auto-tuned from CPU (1-4).
SHARP_CONCURRENCY=
# libvips operation cache in MB; 0 disables it. Auto-tuned from RAM (16-128).
SHARP_CACHE_MB=
# Previews rendered at once; more wait in line. Auto-tuned from CPU/RAM (1-8).
PREVIEW_CONCURRENCY=
# Largest AVIF output (previews and /v1/image), in megapixels. AVIF encoding needs
# about 30 bytes per pixel. Auto-tuned from RAM (2-16 MP).
# AVIF_MAX_MEGAPIXELS=4

# ---- HTML to PDF and images (POST /v1/pdf, /v1/image). Can also be switched on and off in the console ----
# Needs Chromium on the host (apt install chromium fonts-liberation).
RENDER_ENABLED=false
# Let pages load http(s) images, fonts and stylesheets. Off blocks every remote request.
RENDER_ALLOW_REMOTE=false
# Chromium executable. Found on PATH (chromium, google-chrome) when unset.
# CHROME_PATH=/usr/bin/chromium
# Extra Chromium flags, space-separated.
# CHROME_ARGS=
# true in containers without user namespaces (docker-compose.yml sets it).
# CHROME_NO_SANDBOX=true
# Largest image /v1/image may produce, in megapixels (width × height × scale²).
# Each megapixel costs about 17 MB while capturing. Auto-tuned from RAM (4-30 MP).
# RENDER_MAX_MEGAPIXELS=8

# ---- First start only (optional) ----
# Used only when the database has no instance record yet. Afterwards these
# values are ignored; change the project, its keys and its settings in the
# console. See README "Quick start".
#
# Organization ID. Metadata for the console; not used by the Appwrite SDKs.
# ORG_ID=
# The Appwrite project ID every app sends in X-Appwrite-Project.
# PROJECT_ID=
# Comma-separated API keys. Imported once into the API page, hashed;
# they can then be revoked like any console key.
# API_KEYS=
# Signs JWTs and OAuth state. At least 32 random characters when set.
# SECRET=
# PROJECT_NAME=Bunwrite
# Browser origins allowed by CORS and as redirect targets: `*.example.com,localhost`.
ALLOWED_ORIGINS=localhost
# SESSION_DURATION=31536000
# SESSIONS_LIMIT=10
#
# Email (OTP codes, password recovery, team invites). Can also be set in the console.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# 'tls' for implicit TLS on 465; empty uses STARTTLS when offered.
# SMTP_SECURE=
# SMTP_SENDER_EMAIL=no-reply@example.com
# SMTP_SENDER_NAME=Bunwrite Team
#
# Google sign-in. Can also be set in the console.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Comma-separated function IDs whose schedules should be ignored.
# FUNCTIONS_SKIP_SCHEDULES=
