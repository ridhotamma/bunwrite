# Bunwrite configuration.
#
# Copy this file to .env, then set DOMAIN (or leave it empty for localhost).
# Everything else has a working default. For every setting, including tuning,
# S3, backups, Cloudflare Tunnel and first-start seeds, see:
#   docs/CONFIGURATION.md

# ---- Public address ----
# Public hostname, without https:// or a path. Leave empty for localhost.
# DOMAIN=appwrite.example.com

# Full API URL, when TLS ends at a tunnel or another proxy.
# Defaults to https://$DOMAIN/v1 when DOMAIN is set, else http://localhost:$PORT/v1.
# PUBLIC_ENDPOINT=https://appwrite.example.com/v1

# ---- Server ----
# Bind address. 127.0.0.1 is right behind Caddy/cloudflared on this host.
# Docker Compose overrides this to 0.0.0.0 inside the container; use 0.0.0.0
# for a direct public install without a proxy.
HOST=127.0.0.1
PORT=8080

# ---- HTTP workers ----
# Public HTTP processes. The Docker image sets `auto` (one per CPU, Linux only);
# 1 keeps a single process and a number pins the count. A cluster also starts a
# dedicated SQLite writer that never accepts public traffic, so checkpoints and
# lock waits cannot stall client connections.
# WORKERS=auto

# With WORKERS>1, give each public worker its own port (PORT, PORT+1, ...)
# instead of sharing one port with SO_REUSEPORT. Set the proxy upstream to the
# same range (for example UPSTREAM=bunwrite:8080-8083) so Caddy can health-check
# and route around a stalled worker. Off by default; off keeps SO_REUSEPORT.
# WORKER_PORTS=false

# Total in-flight requests across the public workers before returning 503 with
# Retry-After. Health checks always pass. 0 disables shedding.
# MAX_INFLIGHT=200

# Seconds Bun keeps an idle HTTP connection open. Keep this above Caddy's 5s
# upstream keepalive so Caddy never reuses a connection Bun has already closed.
# HTTP_IDLE_TIMEOUT=30

# ---- Proxy upstream (Caddy) ----
# One address, or a worker range when WORKER_PORTS=true. The ask endpoint for
# on-demand TLS must stay a single address.
# UPSTREAM=bunwrite:8080
# ASK_UPSTREAM=bunwrite:8080

# ---- Worker coordination ----
# How often to notice settings/schema changes made by another process.
# 0 checks on every request; a positive value trades freshness for a tiny saving.
# CACHE_CHECK_MS=0

# How often a worker with WebSocket clients reads the cross-process event bus.
# REALTIME_BUS_POLL_MS=100

# ---- SQLite writer ----
# Database writes are handled by a dedicated writer process on a loopback
# listener (PORT + 1, or PORT + 100 with WORKER_PORTS); the public workers
# forward to it so one process owns the write connection and cannot stall
# request handling. Set WRITER_PORT=0 to give every worker its own write path.
# WRITER_PORT=8081

# Group document writes arriving within this many ms into one transaction.
# Defaults to 1 with WORKERS>1, 0 for a single process; 0 disables batching.
# WRITE_BATCH_MS=1

# ---- HTTPS / Docker ----
# Start the bundled Caddy container with Docker Compose.
# Comment this out when using Cloudflare Tunnel or your own proxy.
COMPOSE_PROFILES=caddy

# Who terminates TLS:
#   acme      Caddy obtains and renews certificates (default)
#   external  Caddy serves the certificate files below — for example a
#             Cloudflare Origin Certificate — and still uses on-demand ACME for
#             hosts they do not cover
#   off       Cloudflare Tunnel, an ALB, nginx or another proxy terminates TLS;
#             Caddy listens on HTTP only
# TLS_MODE=acme
# TLS_CERT_FILE=/certs/origin.pem
# TLS_KEY_FILE=/certs/origin.key
# Host directory mounted at /certs when TLS_MODE=external.
# TLS_CERT_DIR=./certs

# ---- Domains ----
# Site:     <site-id>.<SITES_DOMAIN>       (default <site-id>.sites.$DOMAIN)
# Function: <function-id>.<FUNCTIONS_DOMAIN> (default <function-id>.functions.$DOMAIN)
# SITES_PREFIX=sites
# FUNCTIONS_PREFIX=functions
# SITES_DOMAIN=sites.example.com
# FUNCTIONS_DOMAIN=functions.example.com

# ---- Sites ----
# SSR sites are built and run on this server. Idle apps stop on their own.
# SITES_BUILD_COMMANDS=true
# SITES_SSR=true
# SITES_SSR_IDLE_MS=300000
# Per HTTP worker. Each worker keeps its own copy, so with several SSR sites
# prefer WORKERS=1 and raise this to the number of sites you want warm.
# SITES_SSR_MAX_PROCESSES=2
# Previous SSR deployments kept for rollback, besides the live one.
# SITES_SSR_KEEP_PREVIOUS=2

# ---- Runtimes ----
# Node.js and Bun versions for sites and functions are downloaded on first use.
# RUNTIMES_DOWNLOAD=true
# RUNTIMES_NODE_MIRROR=https://nodejs.org/dist

# ---- Git deployments (GitHub) ----
# Create the GitHub App from the console instead, or set these (see docs/GIT.md).
# VCS_GITHUB_APP_ID=
# VCS_GITHUB_APP_NAME=
# VCS_GITHUB_PRIVATE_KEY=
# VCS_GITHUB_CLIENT_ID=
# VCS_GITHUB_CLIENT_SECRET=
# VCS_GITHUB_WEBHOOK_SECRET=

# ---- Data ----
DATABASE_PATH=./data/bunwrite.sqlite
STORAGE_PATH=./data/storage
BACKUPS_PATH=./data/backups
# Memory-mapped database window per connection in MB; 0 disables mmap.
# SQLITE_MMAP_MB=256
# Pages written before a WAL checkpoint; 0 disables automatic checkpoints.
# A larger WAL means fewer synchronous checkpoints on the writer process.
# SQLITE_WAL_AUTOCHECKPOINT=10000
# How long a write waits for SQLite's lock (writer process), and how long a read
# waits before failing fast (public workers). Reads should not block an event
# loop for seconds.
# SQLITE_BUSY_TIMEOUT_MS=5000
# SQLITE_READER_BUSY_TIMEOUT_MS=500
# Encrypts backups. Generate with `openssl rand -base64 32` and keep a copy off
# this server: without it, encrypted backups cannot be opened.
# BACKUP_ENCRYPTION_KEY=

# ---- API naming ----
# bunwrite (default) or appwrite. Both header/cookie families are always read.
API_COMPAT=bunwrite

# ---- Console ----
CONSOLE_ENABLED=true
# Create the first admin automatically. Or run `bun run console:admin`.
# CONSOLE_ADMIN_EMAIL=you@example.com
# CONSOLE_ADMIN_PASSWORD=a-long-password

# ---- Logs ----
LOG_REQUESTS=true
# Log a fraction (0..1) of successful requests; errors are always logged.
# LOG_SAMPLE_RATE=1

# ---- Compression ----
# HTTP response compression. Keep it on when Bunwrite is the public server;
# set false behind Caddy (docker-compose does this by default).
# COMPRESSION=true
# WebSocket per-message compression; independent of HTTP compression.
# WEBSOCKET_COMPRESSION=true
# Shared-cache lifetime for document GETs in collections readable by "any".
# CACHE_PUBLIC_MAX_AGE=0

# ---- Optional features ----
# Schema applied by schema:push and the console.
# SCHEMA_PATH=./appwrite.config.json
# SCHEMA_SYNC_ON_START=false

# Function variables from a dotenv file.
# FUNCTIONS_ENV_FILE=./functions.env

# Function isolation: each function builds and runs as its own user, which can
# only read and write its own folder. `auto` (default) turns it off, with a
# warning, when the helper cannot switch users; `on` refuses to start instead.
# The Docker image has the helper and docker-compose.yml sets `on`. On a
# bare-metal install, install the helper first (docs/ARCHITECTURE.md#functions)
# or the server will not start with `on`.
# FUNCTIONS_SANDBOX=auto

# Function runs at once per project, and retries for a failed async run.
# FUNCTIONS_CONCURRENCY=4
# FUNCTIONS_MAX_ATTEMPTS=1

# HTML to PDF/images. Needs Chromium on the host.
# RENDER_ENABLED=true

# Docker build extras (rebuild with docker compose up -d --build).
# BUNWRITE_WITH_PYTHON=true
# BUNWRITE_WITH_CHROMIUM=true

# ---- First start only ----
# Seeded into an empty database once, then ignored.
# ORG_ID=
# PROJECT_ID=
# PROJECT_NAME=Bunwrite
# API_KEYS=
# SECRET=
# OAuth sign-in, seeded once; edit it in the console afterwards.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
ALLOWED_ORIGINS=localhost
