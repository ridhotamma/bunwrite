[Unit]
Description=Bunwrite (Appwrite-compatible API)
After=network-online.target
Wants=network-online.target

[Service]
User={{ bunwrite_user }}
Group={{ bunwrite_group }}
WorkingDirectory={{ bunwrite_dir }}
Environment=HOME={{ bunwrite_home }}
EnvironmentFile={{ bunwrite_dir }}/.env
ExecStart=/usr/local/bin/bunwrite serve
Restart=always
RestartSec=2
MemoryMax=700M
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
