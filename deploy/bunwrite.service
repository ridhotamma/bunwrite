[Unit]
Description=Bunwrite (Appwrite-compatible API)
After=network-online.target
Wants=network-online.target

[Service]
User=bunwrite
WorkingDirectory=/opt/bunwrite
Environment=HOME=/home/bunwrite
EnvironmentFile=/opt/bunwrite/.env
# Applies the startup-only limits (JSC heap and glibc arenas) from `bunwrite autotune`.
ExecStart=/bin/sh /opt/bunwrite/deploy/bunwrite-autotune.sh
Restart=always
RestartSec=2
# Let the app use most of the host's RAM. Autotune reads this cgroup limit; set
# a fixed value (for example 700M) when Bunwrite shares the machine with others.
MemoryMax=80%
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
