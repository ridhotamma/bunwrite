[Unit]
Description=pesanle-backend (Appwrite-compatible API)
After=network-online.target
Wants=network-online.target

[Service]
User=pesanle
WorkingDirectory=/opt/pesanle-backend
EnvironmentFile=/opt/pesanle-backend/.env
ExecStart=/home/pesanle/.bun/bin/bun src/index.ts
Restart=always
RestartSec=2
# Stay well inside a 1 GB VPS; the API itself uses ~80-150 MB.
MemoryMax=700M
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
