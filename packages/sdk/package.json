{
  "name": "@bunwrite/sdk",
  "version": "0.1.0",
  "description": "SDK for Bunwrite: one client for browsers, Bun, Node.js and edge runtimes, with the API of Appwrite's SDKs.",
  "license": "MIT AND BSD-3-Clause",
  "keywords": [
    "bunwrite",
    "appwrite",
    "sdk",
    "backend"
  ],
  "homepage": "https://github.com/ridhotamma/bunwrite/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ridhotamma/bunwrite.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/ridhotamma/bunwrite/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/bunwrite.iife.js",
  "jsdelivr": "./dist/bunwrite.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "bun run typecheck && (cd ../.. && bun test test/sdk.test.ts test/bunwrite-cli.test.ts) && bun run build"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
