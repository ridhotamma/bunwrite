{
  "name": "@bunwrite/cli",
  "version": "0.6.0",
  "description": "Command-line tool for Bunwrite: sign in, pull and push project config, deploy functions and call any API.",
  "license": "MIT AND BSD-3-Clause",
  "keywords": [
    "bunwrite",
    "appwrite",
    "cli"
  ],
  "homepage": "https://github.com/ridhotamma/bunwrite/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ridhotamma/bunwrite.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ridhotamma/bunwrite/issues"
  },
  "type": "module",
  "bin": {
    "bunwrite": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:binary": "bun scripts/build.ts --binary",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "bun run typecheck && (cd ../.. && bun test test/sdk.test.ts test/bunwrite-cli.test.ts) && bun run build"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
