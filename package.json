{
  "name": "bunwrite",
  "version": "0.9.2",
  "description": "A lightweight, Appwrite-compatible backend on Bun + SQLite + Drizzle.",
  "license": "MIT",
  "keywords": [
    "appwrite",
    "backend",
    "bun",
    "sqlite",
    "self-hosted",
    "headless"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun scripts/build.ts",
    "demo": "bun scripts/console-demo.ts",
    "schema:push": "bun src/cli/schema-push.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "migrate": "bun src/cli/migrate.ts",
    "migrate:postgres": "bun src/cli/migrate-postgres.ts",
    "db:check": "bun src/cli/db.ts check",
    "db:migrate": "bun src/cli/db.ts migrate",
    "db:ping": "bun src/cli/db.ts ping",
    "snapshot": "bun src/cli/snapshot.ts",
    "restore": "bun src/cli/restore.ts",
    "failover": "bun src/cli/failover.ts",
    "backup:open": "bun src/cli/backup-open.ts",
    "console:admin": "bun src/cli/console-admin.ts",
    "autotune": "bun src/main.ts autotune",
    "rag:eval": "bun scripts/rag-eval.ts",
    "stress": "bun scripts/stress/index.ts",
    "stress:seed": "bun scripts/stress/index.ts seed",
    "stress:run": "bun scripts/stress/index.ts run",
    "stress:booking": "bun scripts/stress/booking.ts",
    "stress:social": "bun scripts/stress/social.ts",
    "stress:realtime": "bun scripts/stress/realtime.ts",
    "sdk:sync": "bun scripts/sdk-sync.ts",
    "sdk:build": "cd packages/sdk && bun run build",
    "cli:build": "cd packages/cli && bun run build",
    "mcp": "bun packages/mcp/src/index.ts",
    "mcp:build": "cd packages/mcp && bun run build",
    "mcp:typecheck": "cd packages/mcp && bun run typecheck",
    "format": "prettier --write \"src/db/**/*.ts\" \"src/documents/**/*.ts\" \"src/transactions/**/*.ts\" \"src/settings/**/*.ts\" \"src/logs/**/*.ts\" \"src/variables/**/*.ts\" \"src/webhooks/**/*.ts\" \"src/schema/push-postgres.ts\" \"src/cluster/**/*.ts\" \"src/observability/**/*.ts\"",
    "format:check": "prettier --check \"src/db/**/*.ts\" \"src/documents/**/*.ts\" \"src/transactions/**/*.ts\" \"src/settings/**/*.ts\" \"src/logs/**/*.ts\" \"src/variables/**/*.ts\" \"src/webhooks/**/*.ts\" \"src/schema/push-postgres.ts\" \"src/cluster/**/*.ts\" \"src/observability/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\""
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "minimatch": "^11.0.4"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.1.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "htmx.org": "2.0.11",
    "nodemailer": "10.2.1",
    "sharp": "0.35.5",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/nodemailer": "8.0.2",
    "appwrite": "27.0.0",
    "appwrite-cli": "28.10.2",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "node-appwrite": "29.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1"
  }
}
