{
  "name": "bunwrite",
  "version": "0.1.0",
  "description": "A lightweight, Appwrite-compatible backend on Bun + SQLite + Drizzle.",
  "license": "MIT",
  "keywords": [
    "appwrite",
    "backend",
    "bun",
    "sqlite",
    "self-hosted",
    "headless"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun scripts/build.ts",
    "demo": "bun scripts/console-demo.ts",
    "schema:push": "bun src/cli/schema-push.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "migrate": "bun src/cli/migrate.ts",
    "snapshot": "bun src/cli/snapshot.ts",
    "backup:open": "bun src/cli/backup-open.ts",
    "console:admin": "bun src/cli/console-admin.ts",
    "autotune": "bun src/main.ts autotune",
    "stress": "bun scripts/stress/index.ts",
    "stress:seed": "bun scripts/stress/index.ts seed",
    "stress:run": "bun scripts/stress/index.ts run",
    "stress:booking": "bun scripts/stress/booking.ts",
    "sdk:sync": "bun scripts/sdk-sync.ts",
    "sdk:build": "cd packages/sdk && bun run build",
    "cli:build": "cd packages/cli && bun run build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "htmx.org": "2.0.11",
    "nodemailer": "10.2.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "8.0.2",
    "appwrite": "27.0.0",
    "appwrite-cli": "22.0.0",
    "drizzle-kit": "^0.31.0",
    "node-appwrite": "29.0.0",
    "typescript": "^5.9.0"
  }
}
