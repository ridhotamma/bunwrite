{
  "name": "bunwrite",
  "version": "0.1.0",
  "description": "A lightweight, Appwrite-compatible backend on Bun + SQLite + Drizzle.",
  "license": "MIT",
  "keywords": [
    "appwrite",
    "backend",
    "bun",
    "sqlite",
    "self-hosted",
    "headless"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun scripts/build.ts",
    "demo": "bun scripts/console-demo.ts",
    "schema:push": "bun src/cli/schema-push.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "migrate": "bun src/cli/migrate.ts",
    "snapshot": "bun src/cli/snapshot.ts",
    "console:admin": "bun src/cli/console-admin.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "htmx.org": "2.0.4",
    "nodemailer": "6.9.16",
    "sharp": "0.33.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "6.4.17",
    "appwrite": "27.0.0",
    "drizzle-kit": "^0.31.0",
    "node-appwrite": "29.0.0",
    "typescript": "^5.9.0"
  }
}
