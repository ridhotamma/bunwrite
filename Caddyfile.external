# Caddy with certificates you provide instead of asking an ACME CA.
#
# Use this when TLS certificates come from somewhere else — a Cloudflare Origin
# Certificate, a corporate CA, certbot, or any other provider. Mount the PEM
# files into the container and point TLS_CERT_FILE / TLS_KEY_FILE at them.
#
#   TLS_MODE=external
#   TLS_CERT_FILE=/certs/origin.pem
#   TLS_KEY_FILE=/certs/origin.key
#
# The certificate is loaded into Caddy's shared cache, so any host it covers
# (for example *.pesanle.id) is served without an ACME request. Hosts it does
# not cover — seller custom domains, other site/function hosts — still fall
# through to on-demand TLS, which asks Bunwrite before issuing. Cover every
# host in the certificate, or terminate those hosts at the provider, if you do
# not want Caddy to request public certificates.
#
# Without DOMAIN it serves https://localhost with Caddy's own local CA, which is
# handy for a quick local look but not useful on a VPS.
{
	on_demand_tls {
		# Keep this a single address even when UPSTREAM is a worker range.
		ask http://{$ASK_UPSTREAM:bunwrite:8080}/.well-known/bunwrite/host
	}
}

{$DOMAIN:localhost} {
	encode zstd gzip
	tls {$TLS_CERT_FILE} {$TLS_KEY_FILE}
	reverse_proxy {$UPSTREAM:bunwrite:8080} {
		lb_policy least_conn
		health_uri /v1/health
		health_interval 3s
		health_timeout 2s
		health_fails 3
		health_passes 1
		health_headers {
			Host {$DOMAIN:localhost}
		}
		fail_duration 10s
		max_fails 5
		unhealthy_latency 5s
		lb_try_duration 3s
		transport http {
			# Bun closes idle connections after HTTP_IDLE_TIMEOUT (30s default);
			# keep Caddy's pool shorter so it never reuses a closed one.
			keepalive 5s
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}

# Every other host: Bunwrite's sites and functions, covered by the loaded
# certificate or issued on demand for a host Bunwrite approves.
https:// {
	encode zstd gzip
	tls {$TLS_CERT_FILE} {$TLS_KEY_FILE} {
		on_demand
	}
	reverse_proxy {$UPSTREAM:bunwrite:8080} {
		lb_policy least_conn
		health_uri /v1/health
		health_interval 3s
		health_timeout 2s
		health_fails 3
		health_passes 1
		health_headers {
			Host {$DOMAIN:localhost}
		}
		fail_duration 10s
		max_fails 5
		unhealthy_latency 5s
		lb_try_duration 3s
		transport http {
			keepalive 5s
			dial_timeout 3s
			response_header_timeout 30s
		}
	}
}
